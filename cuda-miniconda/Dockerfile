# Generated by ChatGPT on 28/09/2026

ARG CUDA_VERSION=13.4.2

FROM continuumio/miniconda3:latest

ARG CUDA_VERSION

ENV DEBIAN_FRONTEND=noninteractive
ENV CUDA_VERSION=${CUDA_VERSION}
ENV CUDA_HOME=/usr/local/cuda
ENV CONDA_DIR=/opt/conda

ENV PATH=/opt/conda/bin:/usr/local/cuda/bin:$PATH
ENV LD_LIBRARY_PATH=/usr/local/cuda/lib64:${LD_LIBRARY_PATH}

# ------------------------------------------------------------------------------
# System dependencies
# ------------------------------------------------------------------------------

RUN apt-get update && \
    apt-get install -y --no-install-recommends \
        wget \
        curl \
        git \
        ca-certificates \
        gnupg \
        build-essential \
        bzip2 \
        bash \
        && \
    rm -rf /var/lib/apt/lists/*

# ------------------------------------------------------------------------------
# Install CUDA
# ------------------------------------------------------------------------------

RUN CUDA_MAJOR_MINOR=$(echo "${CUDA_VERSION}" | cut -d. -f1,2 | tr '.' '-') && \
    wget -q \
        "https://developer.download.nvidia.com/compute/cuda/repos/debian13/x86_64/cuda-keyring_1.1-1_all.deb" \
        -O /tmp/cuda-keyring.deb && \
    dpkg -i /tmp/cuda-keyring.deb && \
    rm /tmp/cuda-keyring.deb && \
    apt-get update && \
    apt-get install -y --no-install-recommends \
        "cuda-toolkit-${CUDA_MAJOR_MINOR}" && \
    rm -rf /var/lib/apt/lists/*

# ------------------------------------------------------------------------------
# Conda configuration
# ------------------------------------------------------------------------------

RUN conda config --system \
        --add envs_dirs /opt/conda/envs && \
    conda init bash

RUN echo 'source /root/.bashrc' >> /root/.bash_profile

WORKDIR /workspace

CMD ["/bin/bash"]